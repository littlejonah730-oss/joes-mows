# Frontend (Vite exposes only VITE_-prefixed vars to the browser bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only — used by scripts/import-to-supabase.mjs. NEVER prefix
# this with VITE_, and never commit a real value: it bypasses row-level
# security.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
