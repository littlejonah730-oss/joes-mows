{
  "name": "Announcement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "content": {
      "type": "string",
      "title": "Content"
    },
    "target_type": {
      "type": "string",
      "title": "Target Type",
      "enum": [
        "all",
        "role",
        "individual"
      ],
      "default": "all"
    },
    "target_role": {
      "type": "string",
      "title": "Target Role"
    },
    "target_employee_id": {
      "type": "string",
      "title": "Target Employee ID"
    }
  },
  "required": [
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}