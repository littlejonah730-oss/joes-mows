{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "title": "Job ID"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "amount": {
      "type": "number",
      "title": "Amount",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "paid",
        "unpaid"
      ],
      "default": "unpaid"
    },
    "payment_method": {
      "type": "string",
      "title": "Payment Method",
      "enum": [
        "cash",
        "venmo",
        "cashapp",
        "check",
        "none"
      ],
      "default": "none"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due Date"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "title": "Paid Date"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    },
    "description": {
      "type": "string",
      "title": "Description"
    }
  },
  "required": [
    "customer_id",
    "customer_name",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}