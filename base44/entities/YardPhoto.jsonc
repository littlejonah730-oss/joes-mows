{
  "name": "YardPhoto",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Before/After",
        "Best Work",
        "Seasonal Jobs",
        "Other"
      ],
      "default": "Best Work"
    },
    "customer_id": {
      "type": "string",
      "title": "Customer ID"
    },
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    }
  },
  "required": [
    "title",
    "image_url",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}