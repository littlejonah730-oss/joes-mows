{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_money_summary",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "weekly_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMoneySummary",
            "args": {
              "mode": "weekly"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Weekly money summary"
          }
        }
      }
    ]
  },
  "description": "Every Monday at 6am Central: summarizes the past week to the owner (revenue, expenses, profit, jobs completed, overdue payments)",
  "name": "Weekly Money Summary",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * 1",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}